# Copy to deploy/vps/.env on the server. Do not commit .env. chmod 600.
# The site starts without Anthropic, but chatbot-generated answers require it.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ADMIN_API_KEY=change-me-to-a-long-random-secret
MCP_API_KEY=change-me-to-a-long-random-secret
ENABLE_MCP_HTTP=true
ENABLE_RATE_LIMIT=true

# Nearby development digests (optional). Cron: deploy/vps/send-nearby-digests.sh
# PUBLIC_BASE_URL=https://tracker.esterotoday.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
